#!/usr/bin/env bash
set -euo pipefail
EXPECTED_REMOTE="https://github.com/Nico2603/rayito-de-sol.git"
EXPECTED_OWNER_REPO="Nico2603/rayito-de-sol"
remote_url="$(git remote get-url origin | sed 's#\.git$##')"
expected="$(echo "$EXPECTED_REMOTE" | sed 's#\.git$##')"
if [ "$(echo "$remote_url" | tr '[:upper:]' '[:lower:]')" != "$(echo "$expected" | tr '[:upper:]' '[:lower:]')" ]; then
  echo "POLICY_REMOTE_MISMATCH: origin is $remote_url (expected $EXPECTED_REMOTE)" >&2
  exit 1
fi
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master)
      echo "pre-push: pushing to production branch master for $EXPECTED_OWNER_REPO"
      ;;
  esac
done
exit 0
